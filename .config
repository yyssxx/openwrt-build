# =====================================================================
# d-team newifi-d2 (ramips / mt7621) 全功能 .config
# 源码: coolsnowwolf/lede ｜ 云编译: GitHub Actions
# 底版: 2026-10-15 第 11 次构建成功出包的那份 .config，重新分区整理
#
# 用法:
#   加功能 → 把对应行前面的 # 删掉(改成 =y)，或照格式自己加一行
#   减功能 → 把那一行整个删掉，或改成 # CONFIG_... is not set
#   改完提交 → 重新跑一次 Actions 即可；workflow 里的 make defconfig
#   会自动补齐依赖，你不用管依赖关系
# 注意: 功能越多固件越大，刷机前确认路由器 flash 空间够用
# =====================================================================


# ---------- 一、目标设备(别动) ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y


# ---------- 二、LuCI 中文 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y


# ---------- 三、主题(默认关闭，按需打开) ----------
# CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-app-argon-config=y


# ---------- 四、代理 / VPN(主力) ----------
# ssr-plus 主程序(下面 INCLUDE 行会自动把它带上，这里显式写一行更保险)
CONFIG_PACKAGE_luci-app-ssr-plus=y
# ssr-plus 要带哪些核心: 需要就 =y，不需要就改成 is not set 或删掉
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
#CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan is not set
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria=y
#CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server is not set
#CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server is not set
#CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_V2ray_Plugin is not set
#CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_IPT2Socks is not set
#CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Redsocks2 is not set
# 这几个默认不装，需要再打开
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_TUIC=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY is not set

# 各核心本体(显式列出，defconfig 也会自动补)
CONFIG_PACKAGE_xray-core=y
#CONFIG_PACKAGE_trojan is not set
CONFIG_PACKAGE_naiveproxy=y
CONFIG_PACKAGE_hysteria=y
#CONFIG_PACKAGE_shadowsocks-libev-ss-server=y
#CONFIG_PACKAGE_shadowsocksr-libev-ssr-server=y
#CONFIG_PACKAGE_v2ray-plugin=y
#CONFIG_PACKAGE_ipt2socks is not set
#CONFIG_PACKAGE_redsocks2 is not set

# 组网 VPN
#CONFIG_PACKAGE_zerotier=y
#CONFIG_PACKAGE_luci-app-zerotier=y
#CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# WireGuard / OpenVPN(默认关闭，按需打开)
# CONFIG_PACKAGE_luci-app-wireguard=y
# CONFIG_PACKAGE_luci-proto-wireguard=y
# CONFIG_PACKAGE_luci-app-openvpn=y


# ---------- 五、内网穿透 ----------
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y
#CONFIG_PACKAGE_npc is not set
#CONFIG_PACKAGE_luci-app-nps is not set
#CONFIG_PACKAGE_luci-i18n-nps-zh-cn is not set


# ---------- 六、手机 USB 共享上网 ----------
# 安卓(RNDIS / CDC)
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usb-modeswitch=y
# 苹果(ipheth / usbmuxd)
#CONFIG_PACKAGE_kmod-usb-net-ipheth is not set
#CONFIG_PACKAGE_usbmuxd is not set
#CONFIG_PACKAGE_libimobiledevice is not set


# ---------- 七、DDNS ----------
CONFIG_PACKAGE_ddns-scripts_cloudflare.com-v4=y
CONFIG_PACKAGE_ddns-scripts_no-ip_com=y
# 想要 LuCI 界面配 DDNS 再打开下面这行
 CONFIG_PACKAGE_luci-app-ddns=y


# ---------- 八、去广告 / DNS(默认关闭，按需打开) ----------
# CONFIG_PACKAGE_luci-app-adguardhome=y
# CONFIG_PACKAGE_luci-app-smartdns=y


# ---------- 九、常用小工具(默认关闭，按需打开) ----------
# CONFIG_PACKAGE_luci-app-ttyd=y                # 网页终端
# CONFIG_PACKAGE_luci-app-upnp=y                # UPnP 端口转发
# CONFIG_PACKAGE_luci-app-wol=y                 # 网络唤醒
# CONFIG_PACKAGE_luci-app-arpbind=y             # IP/MAC 绑定
# CONFIG_PACKAGE_luci-app-autoreboot=y          # 定时重启
# CONFIG_PACKAGE_luci-app-nlbwmon=y             # 流量统计
# CONFIG_PACKAGE_luci-app-samba4=y              # 文件共享
# CONFIG_PACKAGE_luci-app-vsftpd=y              # FTP 服务
# CONFIG_PACKAGE_luci-app-transmission=y        # PT 下载
# CONFIG_PACKAGE_luci-app-v2ray-server=y        # v2ray 服务器(老配置里有，需要再开)
# CONFIG_PACKAGE_luci-app-accesscontrol=m       # 上网时间控制(m=编成独立包)
# CONFIG_PACKAGE_luci-app-unblockmusic=y        # 网易云音乐解锁


# ---------- 十、IPv6(lede 默认带，按需增减) ----------
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_kmod-sit=y
CONFIG_PACKAGE_kmod-iptunnel=y
CONFIG_PACKAGE_kmod-iptunnel4=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c_ext_cer_id=0
CONFIG_PACKAGE_odhcpd_ipv6only_ext_cer_id=0


# ---------- 十一、基础依赖(编译通过的组合，别动) ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_boost=y
CONFIG_PACKAGE_boost-date_time=y
CONFIG_PACKAGE_boost-program_options=y
CONFIG_PACKAGE_boost-system=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libcares=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libevent2=y
CONFIG_PACKAGE_libminiupnpc=y
CONFIG_PACKAGE_libnatpmp=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_NGHTTP2=y
CONFIG_LIBCURL_NO_SMB="!"
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_boost-compile-visibility-hidden=y
CONFIG_boost-runtime-shared=y
CONFIG_boost-static-and-shared-libs=y
CONFIG_boost-variant-release=y
# CONFIG_PACKAGE_etherwake is not set
# CONFIG_PACKAGE_kmod-nf-conntrack-netlink is not set
# CONFIG_PACKAGE_nlbwmon is not set
# CONFIG_PACKAGE_vsftpd-alt is not set
# CONFIG_PACKAGE_wol is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui is not set


# ---------- 十二、构建机 node 版本(配合 diy-part2.sh 的 sed，别动) ----------
# 真正起作用的是 diy-part2.sh 里把 node 换成 v22.23.0，这行只是标记
CONFIG_NODEJS_22=y
